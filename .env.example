# Optional. Used for daily overviews, topic analysis, and daily report drafts.
# When absent, WcCAT falls back to local summaries, rules, and templates.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional administrator access. Generate locally with npm run admin:password.
# Set these as Northflank Runtime secrets; never commit real values.
WCCAT_ADMIN_PASSWORD_HASH=
WCCAT_ADMIN_SESSION_SECRET=
