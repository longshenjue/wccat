# Optional. Used for daily overviews, topic analysis, and daily report drafts.
# When absent, WcCAT falls back to local summaries, rules, and templates.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Explicit single-story generation researches before writing. Preview/save/export stay offline.
WCCAT_TOPIC_RESEARCH_ENABLED=true
# Optional reliable web-search API; without it use public news RSS + encyclopedia discovery.
# Runtime secret only. https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
# Optional. Enables the six authorized TianAPI hotlists; server Runtime Secret only.
TIANAPI_KEY=
TIANAPI_ENABLED=true
TIANAPI_ENDPOINTS=networkhot,weibohot,nethot,toutiaohot,wxhottopic,douyinhot
# Conservative attempt cap per endpoint per Beijing day, allowed range 1–100.
TIANAPI_DAILY_LIMIT=90
# Optional sampled comment examples; DeepSeek classifies comments against the existing attitudes.
WCCAT_COMMENTS_ENABLED=true
WCCAT_COMMENT_TOPICS=10
# Hard maximum 100 requests/day across sources, including metadata and empty-hot-list fallbacks.
WCCAT_COMMENT_DAILY_LIMIT=100
# Optional administrator access. Generate locally with npm run admin:password.
# Set these as Northflank Runtime secrets; never commit real values.
WCCAT_ADMIN_PASSWORD_HASH=
WCCAT_ADMIN_SESSION_SECRET=
